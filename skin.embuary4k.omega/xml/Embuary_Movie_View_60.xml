                </control>
                <!-- Panel mit Postern darunter -->
                <control id="60" type="panel">
                    <top>510</top>
                    <height>1650</height>
                    <width>auto</width>
                    <visible>$EXP[MovieViewVisible]</visible>
                    <include>FocusBounce</include>
                    <onright condition="Control.IsVisible(7000)">SetFocus(7000)</onright>
                    <onright condition="!Control.IsVisible(7000) + Control.IsVisible(17)">17</onright>
                    <onright>noop</onright>
                    <ondown>noop</ondown>
                    <onup>SetFocus(6666)</onup>
                    <onleft>900</onleft>
                    <include>ScrollTime</include>
                    <orientation>vertical</orientation>
                    <preloaditems>4</preloaditems>
                    <defaultcontrol always="true">0</defaultcontrol>
                    <viewtype label="$LOCALIZE[20021]">panel</viewtype>
                    <pagecontrol>17</pagecontrol>
                    <oninfo condition="String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(Container(2001).ListItem.Label)">RunScript(script.embuary.helper,action=textviewer,header='$ESCINFO[ListItem.Title]',message='$ESCVAR[ListViewPlot]')</oninfo>
                    <itemlayout width="257" height="445">
                        <control type="group">
                            <left>70.5</left>
                            <top>10</top>
                            <include content="PosterLayout">
                                <param name="mainlabel" value="$INFO[ListItem.Title]" />
                                <param name="thumblabel" value="" />
                                <param name="ar" value="" />
                                <param name="focused" value="false" />
                                <param name="id" value="60" />
                            </include>
                        </control>
                    </itemlayout>
                    <focusedlayout width="257" height="445">
                        <include content="SetPropertyOnFocus">
                            <param name="id" value="60"/>
                        </include>
                        <control type="group">
                            <left>70.5</left>
                            <top>10</top>
                            <include content="PosterLayout">
                                <param name="mainlabel" value="$INFO[ListItem.Title]" />
                                <param name="thumblabel" value="" />
                                <param name="ar" value="" />
                                <param name="focused" value="true" />
                                <param name="id" value="60" />
                                <param name="visible_forced" value="true"/>
                            </include>
                        </control>
                    </focusedlayout>
                </control>
            </control>
        </definition>
    </include>
