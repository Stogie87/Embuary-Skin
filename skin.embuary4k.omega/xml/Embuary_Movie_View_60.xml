			<!-- Codec Flags Ende -->

                        <!-- meta -->
                        <control type="group">
                            <visible>!ListItem.IsParentFolder</visible>
                            <top>-5</top>
                            <left>370</left>
                            <right>70</right>
                            <height>500</height>
                            <!-- title -->
                            <control type="label">
                                <right>440</right>
                                <height>60</height>
                                <label>$INFO[ListItem.Title]</label>
                                <aligny>top</aligny>
                                <font>Reg37</font>
                            </control>
                            <!-- meta -->
                            <control type="group">
                                <top>60</top>
                                <right>440</right>
                                <height>40</height>
                                <include>MetaSetInfos</include>
                                <visible>Container.Content(sets) | String.IsEqual(ListItem.DBType,set)</visible>
                            </control>
                            <control type="group">
                                <top>60</top>
                                <right>440</right>
                                <height>40</height>
                                <include>MetaShowInfos</include>
                                <visible>Container.Content(tvshows)</visible>
                            </control>
                            <control type="group">
                                <top>60</top>
                                <right>440</right>
                                <height>40</height>
                                <include>MetaMovieInfos</include>
                                <visible>!Container.Content(tvshows) + !Container.Content(sets) + !String.IsEqual(ListItem.DBType,set)</visible>
                            </control>
                            <!-- genre -->
                            <control type="group">
                                <top>80</top>
                                <include>MetaGenre</include>
                            </control>
                            <!-- plot -->
                            <control type="textbox">
                                <top>115</top>
                                <width>100%</width>
                                <height max="240">auto</height>
                                <align>justify</align>
                                <aligny>top</aligny>
                                <label>$VAR[SetViewPlot]</label>
                                <font>Light24</font>
                                <autoscroll>true</autoscroll>
                            </control>
                            <!-- video meta-->
                            <control type="group">
                                <top>390</top>
                                <height>40</height>
                                <include>MetaMediaInfo</include>
                            </control>
                        </control>
                        <!-- logo -->
                        <include>MetaClearlogoSmall</include>
