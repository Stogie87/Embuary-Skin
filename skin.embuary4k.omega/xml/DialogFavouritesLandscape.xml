<window type="dialog">
    <defaultcontrol>9000</defaultcontrol>
    <controls>
        <!-- Hintergrund, exakt mittig für 3840x2160 -->
        <control type="image">
            <left>870</left>
            <top>405</top>
            <width>2100</width>
            <height>900</height>
            <texture border="50">common/corner.png</texture>
            <colordiffuse>AAFFFFFF</colordiffuse>
        </control>

        <!-- Kategorienliste (vertikal, links im Hintergrund) -->
        <control type="list" id="9000">
            <left>765</left>
            <top>450</top>
            <width>525</width>
            <height>1080</height>
            <orientation>vertical</orientation>
            <onright>9001</onright>
            <itemlayout width="630" height="135">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>630</width>
                    <height>135</height>
                    <font>Font36</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="630" height="135">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>630</width>
                    <height>135</height>
                    <font>Font36_Bold</font>
                    <textcolor>selected</textcolor>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- Kategorie-Titel, mittig oben im Hintergrund -->
        <control type="label" id="9002">
            <left>1500</left>
            <top>450</top>
            <width>840</width>
            <height>120</height>
            <font>Font36_Bold</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>center</align>
            <aligny>center</aligny>
        </control>

        <!-- Horizontale Favoritenliste, rechts im Hintergrund -->
        <control type="list" id="9001">
            <left>1275</left>
            <top>600</top>
            <width>1650</width>
            <height>510</height>
            <orientation>horizontal</orientation>
            <itemlayout width="324" height="432">
                <control type="image">
                    <left>36</left>
                    <top>0</top>
                    <width>288</width>
                    <height>432</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="342" height="477">
                <control type="image">
                    <left>24</left>
                    <top>0</top>
                    <width>318</width>
                    <height>477</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
            </focusedlayout>
        </control>

        <!-- Titel des selektierten Items, mittig unter der Favoritenliste -->
        <control type="label">
            <left>1305</left>
            <top>1148</top>
            <width>1605</width>
            <height>90</height>
            <font>Font24</font>
            <textcolor>FFBBBBBB</textcolor>
            <align>left</align>
            <aligny>left</aligny>
            <scroll>true</scroll>
            <label>$INFO[Container(9001).ListItem.Label]</label>
        </control>
    </controls>
</window>
