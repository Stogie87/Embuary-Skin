<window type="dialog">
    <defaultcontrol always="true">9000</defaultcontrol>
    <controls>
        <!-- Zentrierter, abgerundeter Hintergrund für 3840x2160 -->
        <control type="image">
            <left>1380</left>
            <top>630</top>
            <width>1080</width>
            <height>760</height>
            <texture border="50">common/corner.png</texture>
            <colordiffuse>8AFFFFFF</colordiffuse>
        </control>
        <!-- Poster-Liste -->
        <control type="list" id="9000">
            <left>1410</left>
            <top>680</top>
            <width>1020</width>
            <height>660</height>
            <orientation>vertical</orientation>
            <itemlayout height="220" width="560">
                <control type="image">
                    <left>0</left>
                    <top>5</top>
                    <width>95</width>
                    <height>210</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>145</left>
                    <top>65</top>
                    <width>880</width>
                    <height>80</height>
                    <font>font10</font>
                    <label>$INFO[ListItem.Label]</label>
                    <align>left</align>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <scroll>true</scroll>
                </control>
            </itemlayout>
            <focusedlayout height="220" width="560">
                <control type="image">
                    <left>0</left>
                    <top>5</top>
                    <width>95</width>
                    <height>210</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>145</left>
                    <top>65</top>
                    <width>880</width>
                    <height>80</height>
                    <font>font10_title</font>
                    <label>$INFO[ListItem.Label]</label>
                    <align>left</align>
                    <aligny>center</aligny>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <scroll>true</scroll>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>