				</control>
				<control type="image">
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture>flags/modern/hdr_type/hlg.png</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.StartsWith(Skin.String(codeclogos_flag_path),flags/modern) + String.IsEqual(Window(Home).Property(EmbuaryHDRFallback.HdrType),hlg)</visible>
				</control>

				<!-- Generic HDR -->
				<control type="image">
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture>flags/standard/hdr_type/hdr.png</texture>
					<aspectratio>keep</aspectratio>
