			<control type="group">
				<top>$PARAM[top]</top>
				<left>$PARAM[left]</left>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<visible>$PARAM[visible]</visible>
				<visible>String.IsEqual(ListItem.DBType,movie)</visible>
				<visible>String.IsEmpty(ListItem.HdrType)</visible>
				<visible>!String.IsEmpty(Window(Home).Property(EmbuaryHDRFallback.HdrType))</visible>

				<!-- Dolby Vision -->
				<control type="image">
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture>flags/standard/hdr_type/dolbyvision.png</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.StartsWith(Skin.String(codeclogos_flag_path),flags/standard) + String.IsEqual(Window(Home).Property(EmbuaryHDRFallback.HdrType),dolbyvision)</visible>
				</control>
				<control type="image">
