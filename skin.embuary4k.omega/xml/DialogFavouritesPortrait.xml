<window type="dialog">
    <defaultcontrol>9001</defaultcontrol>
    <controls>
        <!-- Hintergrund, exakt mittig für 3840x2160 -->
        <control type="image">
            <left>870</left>
            <top>405</top>
            <width>2100</width>
            <height>1110</height>
            <texture border="50">common/corner.png</texture>
            <colordiffuse>AAFFFFFF</colordiffuse>
        </control>

        <!-- Kategorienliste (horizontal, oben im Hintergrund) -->
        <control type="list" id="9000">
            <left>930</left>
            <top>443</top>
            <width>1980</width>
            <height>120</height>
            <orientation>horizontal</orientation>
            <onright>9000</onright>
            <onleft>9000</onleft>
            <ondown>9001</ondown>
            <itemlayout width="315" height="120">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>315</width>
                    <height>120</height>
                    <font>Font36</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="315" height="120">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>315</width>
                    <height>120</height>
                    <font>Font36_Bold</font>
                    <textcolor>selected</textcolor>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- Kategorie-Titel, mittig oben im Hintergrund -->
        <control type="label" id="9002">
            <left>1500</left>
            <top>555</top>
            <width>840</width>
            <height>90</height>
            <font>Font36_Bold</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <visible>false</visible>
        </control>

        <!-- Vertikale Favoritenliste, unter den Tabs -->
        <control type="list" id="9001">
            <left>1005</left>
            <top>600</top>
            <width>1800</width>
            <height>832</height>
            <orientation>vertical</orientation>
            <onup>9000</onup>
            <itemlayout width="1650" height="270">
                <control type="image">
                    <left>0</left>
                    <top>10</top>
                    <width>165</width>
                    <height>248</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>195</left>
                    <top>80</top>
                    <width>1650</width>
                    <height>75</height>
                    <font>Font32</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>left</align>
                    <label>$INFO[ListItem.Label]</label>
                    <scroll>true</scroll>
                </control>
            </itemlayout>
            <focusedlayout width="1650" height="285">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>180</width>
                    <height>270</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>210</left>
                    <top>78</top>
                    <width>1635</width>
                    <height>90</height>
                    <font>Font32_Bold</font>
                    <textcolor>selected</textcolor>
                    <align>left</align>
                    <label>$INFO[ListItem.Label]</label>
                    <scroll>true</scroll>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
