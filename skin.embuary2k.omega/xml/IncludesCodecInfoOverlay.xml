<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="CodecInfoOverlayBottomRight">
		<control type="group">
			<top>1320</top>
			<left>0</left> <!-- Start ganz links -->
			<width>2560</width> <!-- Volle 2K-Bildschirmbreite -->
			<height>120</height>

			<!-- Hintergrund über die komplette Breite -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>2560</width>
				<height>120</height>
				<aspectratio>stretch</aspectratio>
				<texture colordiffuse="80FFFFFF">common/noise.png</texture>
			</control>

			<!-- Episode/Film mit eigenem Poster -->
			<control type="image">
				<top>10</top>
				<left>10</left>
				<width>70</width>
				<height>100</height>
				<aspectratio>keep</aspectratio>
				<texture fallback="DefaultVideoCover.png">$INFO[ListItem.Art(poster)]</texture>
				<visible>!String.IsEmpty(ListItem.Art(poster))</visible>
			</control>

			<!-- Fallback: Staffelposter hat Priorität -->
			<control type="image">
				<top>10</top>
				<left>10</left>
				<width>70</width>
				<height>100</height>
				<aspectratio>keep</aspectratio>
				<texture fallback="DefaultVideoCover.png">$INFO[ListItem.Art(season.poster)]</texture>
				<visible>String.IsEmpty(ListItem.Art(poster)) + !String.IsEmpty(ListItem.Art(season.poster))</visible>
			</control>

			<!-- Fallback: Serienposter nur wenn kein Seasonposter -->
			<control type="image">
				<top>10</top>
				<left>10</left>
				<width>70</width>
				<height>100</height>
				<aspectratio>keep</aspectratio>
				<texture fallback="DefaultVideoCover.png">$INFO[ListItem.Art(tvshow.poster)]</texture>
				<visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(season.poster)) + !String.IsEmpty(ListItem.Art(tvshow.poster))</visible>
			</control>

			<!-- Titel des fokussierten Videos -->

			<control type="label">
				<top>40</top>
				<left>90</left>
				<width>1200</width>
				<height>50</height>
				<font>Font30</font>
				<textcolor>white</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<align>left</align>
			</control>

			<!-- Flaggen rechtsbündig -->

  			<control type="group">
    				<left>1830</left>
    				<width>120</width>
    				<height>120</height>
    				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/standard)">PosterStaticFlagshdr_type_standard</include>
    				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/colorful)">PosterStaticFlagshdr_type_colorful</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/estuary)">PosterStaticFlagshdr_type_estuary</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/metropolis)">PosterStaticFlagshdr_type_metropolis</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/modern)">PosterStaticFlagshdr_type_modern</include>
  			</control>

			<control type="group">
				<left>1970</left>
				<width>120</width>
				<height>120</height>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/standard)">PosterStaticFlagsvideoresolution_standard</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/colorful)">PosterStaticFlagsvideoresolution_colorful</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/estuary)">PosterStaticFlagsvideoresolution_estuary</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/metropolis)">PosterStaticFlagsvideoresolution_metropolis</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/modern)">PosterStaticFlagsvideoresolution_modern</include>
			</control>

			<control type="group">
				<left>2110</left>
				<width>120</width>
				<height>120</height>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/standard)">PosterStaticFlagsvideocodec_standard</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/colorful)">PosterStaticFlagsvideocodec_colorful</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/estuary)">PosterStaticFlagsvideocodec_estuary</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/metropolis)">PosterStaticFlagsvideocodec_metropolis</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/modern)">PosterStaticFlagsvideocodec_modern</include>
			</control>

			<control type="group">
				<left>2250</left>
				<width>120</width>
				<height>120</height>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/standard)">PosterStaticFlagsaudiochannels_standard</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/colorful)">PosterStaticFlagsaudiochannels_colorful</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/estuary)">PosterStaticFlagsaudiochannels_estuary</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/metropolis)">PosterStaticFlagsaudiochannels_metropolis</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/modern)">PosterStaticFlagsaudiochannels_modern</include>
			</control>

			<control type="group">
				<left>2390</left>
				<width>120</width>
				<height>120</height>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/standard)">PosterStaticFlagsaudiocodec_standard</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/colorful)">PosterStaticFlagsaudiocodec_colorful</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/estuary)">PosterStaticFlagsaudiocodec_estuary</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/metropolis)">PosterStaticFlagsaudiocodec_metropolis</include>
				<include condition="String.StartsWith(Skin.String(codeclogos_flag_path),flags/modern)">PosterStaticFlagsaudiocodec_modern</include>
			</control>
		</control>
	</include>
</includes>
