<window type="dialog">
    <defaultcontrol>9001</defaultcontrol>
    <controls>
        <!-- Hintergrund, exakt mittig für 2560x1440 -->
        <control type="image">
            <left>580</left>
            <top>270</top>
            <width>1400</width>
            <height>740</height>
            <texture border="50">common/corner.png</texture>
            <colordiffuse>AAFFFFFF</colordiffuse>
        </control>

        <!-- Kategorienliste (horizontal, oben im Hintergrund) -->
        <control type="list" id="9000">
            <left>620</left>
            <top>295</top>
            <width>1320</width>
            <height>80</height>
            <orientation>horizontal</orientation>
            <onright>9000</onright>
            <onleft>9000</onleft>
            <ondown>9001</ondown>
            <itemlayout width="210" height="80">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>210</width>
                    <height>80</height>
                    <font>Font36</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="210" height="80">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>210</width>
                    <height>80</height>
                    <font>Font36_Bold</font>
                    <textcolor>selected</textcolor>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- Kategorie-Titel, mittig oben im Hintergrund -->
        <control type="label" id="9002">
            <left>1000</left>
            <top>370</top>
            <width>560</width>
            <height>60</height>
            <font>Font36_Bold</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <visible>false</visible>
        </control>

        <!-- Vertikale Favoritenliste, unter den Tabs -->
        <control type="list" id="9001">
            <left>670</left>
            <top>400</top>
            <width>1200</width>
            <height>555</height>
            <orientation>vertical</orientation>
            <onup>9000</onup>
            <itemlayout width="1100" height="180">
                <control type="image">
                    <left>0</left>
                    <top>7</top>
                    <width>110</width>
                    <height>165</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>130</left>
                    <top>53</top>
                    <width>1100</width>
                    <height>50</height>
                    <font>Font32</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>left</align>
                    <label>$INFO[ListItem.Label]</label>
                    <scroll>true</scroll>
                </control>
            </itemlayout>
            <focusedlayout width="1100" height="190">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>120</width>
                    <height>180</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>140</left>
                    <top>52</top>
                    <width>1090</width>
                    <height>60</height>
                    <font>Font32_Bold</font>
                    <textcolor>selected</textcolor>
                    <align>left</align>
                    <label>$INFO[ListItem.Label]</label>
                    <scroll>true</scroll>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
