<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="Movie_View_60">
        <definition>
            <control type="group">
                <include>Visible_OpenClose</include>
                <visible>Control.IsVisible(60)</visible>
                <!-- Meta-Bereich oben -->
                <control type="group">
                    <height>124</height>
                    <control type="group">
                        <top>78</top>
                        <height>435</height>
                        <!-- poster -->
                        <include content="MetaPoster">
                            <param name="visible" value="Integer.IsGreater(Container.NumItems,0)"/>
                        </include>
                        <!-- meta -->
                        <control type="group">
                            <visible>!ListItem.IsParentFolder</visible>
                            <top>-5</top>
                            <left>370</left>
                            <right>70</right>
                            <height>500</height>
                            <!-- title -->
                            <control type="label">
                                <right>440</right>
                                <height>60</height>
                                <label>$INFO[ListItem.Title]</label>
                                <aligny>top</aligny>
                                <font>Reg37</font>
                            </control>
                            <!-- meta -->
                            <control type="group">
                                <top>60</top>
                                <right>440</right>
                                <height>40</height>
                                <include>MetaSetInfos</include>
                                <visible>Container.Content(sets) | String.IsEqual(ListItem.DBType,set)</visible>
                            </control>
                            <control type="group">
                                <top>60</top>
                                <right>440</right>
                                <height>40</height>
                                <include>MetaShowInfos</include>
                                <visible>Container.Content(tvshows)</visible>
                            </control>
                            <control type="group">
                                <top>60</top>
                                <right>440</right>
                                <height>40</height>
                                <include>MetaMovieInfos</include>
                                <visible>!Container.Content(tvshows) + !Container.Content(sets) + !String.IsEqual(ListItem.DBType,set)</visible>
                            </control>
                            <!-- genre -->
                            <control type="group">
                                <top>80</top>
                                <include>MetaGenre</include>
                            </control>
                            <!-- plot -->
                            <control type="textbox">
                                <top>115</top>
                                <width>100%</width>
                                <height max="235">auto</height>
                                <align>justify</align>
                                <aligny>top</aligny>
                                <label>$VAR[SetViewPlot]</label>
                                <font>Light24</font>
                                <autoscroll>false</autoscroll>
                            </control>
                            <!-- video meta-->
                            <control type="group">
                                <top>390</top>
                                <height>40</height>
                                <include>MetaMediaInfo</include>
                            </control>
                        </control>
                        <!-- logo -->
                        <include>MetaClearlogoSmall</include>
                    </control>
                </control>
                <!-- Panel mit Postern darunter -->
                <control id="60" type="panel">
                    <top>510</top>
                    <height>930</height>
                    <width>auto</width>
                    <visible>$EXP[MovieViewVisible]</visible>
                    <include>FocusBounce</include>
                    <onright condition="Control.IsVisible(7000)">SetFocus(7000)</onright>
                    <onright condition="!Control.IsVisible(7000) + Control.IsVisible(17)">17</onright>
                    <onright>noop</onright>
                    <ondown>noop</ondown>
                    <onup>SetFocus(6666)</onup>
                    <onleft>900</onleft>
                    <include>ScrollTime</include>
                    <orientation>vertical</orientation>
                    <preloaditems>4</preloaditems>
                    <defaultcontrol always="true">0</defaultcontrol>
                    <viewtype label="$LOCALIZE[20021]">panel</viewtype>
                    <pagecontrol>17</pagecontrol>
                    <oninfo condition="String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(Container(2001).ListItem.Label)">RunScript(script.embuary.helper,action=textviewer,header='$ESCINFO[ListItem.Title]',message='$ESCVAR[ListViewPlot]')</oninfo>
                    <itemlayout width="257" height="445">
                        <control type="group">
                            <left>70.5</left>
                            <top>10</top>
                            <include content="PosterLayout">
                                <param name="mainlabel" value="$INFO[ListItem.Title]" />
                                <param name="thumblabel" value="" />
                                <param name="ar" value="" />
                                <param name="focused" value="false" />
                                <param name="id" value="60" />
                            </include>
                        </control>
                    </itemlayout>
                    <focusedlayout width="257" height="445">
                        <include content="SetPropertyOnFocus">
                            <param name="id" value="60"/>
                        </include>
                        <control type="group">
                            <left>70.5</left>
                            <top>10</top>
                            <include content="PosterLayout">
                                <param name="mainlabel" value="$INFO[ListItem.Title]" />
                                <param name="thumblabel" value="" />
                                <param name="ar" value="" />
                                <param name="focused" value="true" />
                                <param name="id" value="60" />
                                <param name="visible_forced" value="true"/>
                            </include>
                        </control>
                    </focusedlayout>
                </control>
            </control>
        </definition>
    </include>
</includes>
