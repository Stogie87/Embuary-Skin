<window type="dialog">
    <defaultcontrol always="true">9000</defaultcontrol>
    <controls>
        <!-- Zentrierter, abgerundeter Hintergrund für 2560x1440 -->
        <control type="image">
            <left>830</left>
            <top>370</top>
            <width>900</width>
            <height>610</height>
            <texture border="50">common/corner.png</texture>
            <colordiffuse>8AFFFFFF</colordiffuse>
        </control>
        <!-- Poster-Liste -->
        <control type="list" id="9000">
            <left>860</left>
            <top>420</top>
            <width>960</width>
            <height>510</height>
            <orientation>vertical</orientation>
            <itemlayout height="170" width="600">
                <control type="image">
                    <left>0</left>
                    <top>5</top>
                    <width>80</width>
                    <height>160</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>130</left>
                    <top>55</top>
                    <width>700</width>
                    <height>60</height>
                    <font>font10</font>
                    <label>$INFO[ListItem.Label]</label>
                    <align>left</align>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <scroll>true</scroll>
                </control>
            </itemlayout>
            <focusedlayout height="170" width="600">
                <control type="image">
                    <left>0</left>
                    <top>5</top>
                    <width>80</width>
                    <height>160</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>130</left>
                    <top>55</top>
                    <width>700</width>
                    <height>60</height>
                    <font>font10_title</font>
                    <label>$INFO[ListItem.Label]</label>
                    <align>left</align>
                    <aligny>center</aligny>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <scroll>true</scroll>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
