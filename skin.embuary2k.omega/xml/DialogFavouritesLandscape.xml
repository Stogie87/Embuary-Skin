<window type="dialog">
    <defaultcontrol>9000</defaultcontrol>
    <controls>
        <!-- Hintergrund, exakt mittig für 2560x1440 -->
        <control type="image">
            <left>580</left>
            <top>270</top>
            <width>1400</width>
            <height>600</height>
            <texture border="50">common/corner.png</texture>
            <colordiffuse>AAFFFFFF</colordiffuse>
        </control>

        <!-- Kategorienliste (vertikal, links im Hintergrund) -->
        <control type="list" id="9000">
            <left>510</left>
            <top>300</top>
            <width>350</width>
            <height>720</height>
            <orientation>vertical</orientation>
            <onright>9001</onright>
            <itemlayout width="420" height="90">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>420</width>
                    <height>90</height>
                    <font>Font36</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="420" height="90">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>420</width>
                    <height>90</height>
                    <font>Font36_Bold</font>
                    <textcolor>selected</textcolor>
                    <align>center</align>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- Kategorie-Titel, mittig oben im Hintergrund -->
        <control type="label" id="9002">
            <left>1000</left>
            <top>300</top>
            <width>560</width>
            <height>80</height>
            <font>Font36_Bold</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>center</align>
            <aligny>center</aligny>
        </control>

        <!-- Horizontale Favoritenliste, rechts im Hintergrund -->
        <control type="list" id="9001">
            <left>850</left>
            <top>400</top>
            <width>1100</width> <!-- Angepasst für mehr Abstand -->
            <height>340</height>
            <orientation>horizontal</orientation>
            <itemlayout width="216" height="288"> <!-- 192 + 24 Abstand -->
                <control type="image">
                    <left>24</left> <!-- Mehr Abstand links -->
                    <top>0</top>
                    <width>192</width>
                    <height>288</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="228" height="318">
                <control type="image">
                    <left>16</left> <!-- Mehr Abstand im Fokus -->
                    <top>0</top>
                    <width>212</width>
                    <height>318</height>
                    <aspectratio>scale</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
            </focusedlayout>
        </control>

        <!-- Titel des selektierten Items, mittig unter der Favoritenliste -->
        <control type="label">
            <left>870</left>
            <top>765</top>
            <width>1070</width>
            <height>60</height>
            <font>Font24</font>
            <textcolor>FFBBBBBB</textcolor>
            <align>left</align>
            <aligny>left</aligny>
            <scroll>true</scroll>
            <label>$INFO[Container(9001).ListItem.Label]</label>
        </control>
    </controls>
</window>
