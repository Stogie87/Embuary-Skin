<?xml version="1.0" encoding="utf-8"?>
<window>
    <defaultcontrol always="true">10010</defaultcontrol>
    <backgroundcolor>background</backgroundcolor>

    <!-- Property-Handling -->
    <include content="PropertyIncludes">
        <param name="ShowHeader" value="true"/>
    </include>

    <controls>
        <!-- Hintergrund -->
        <include content="Background">
            <param name="forced_visible" value="true"/>
            <param name="auto_hide">false</param>
            <param name="hide_header">false</param>
        </include>

        <!-- HEADERBAR -->
        <include content="HeaderBar">
            <param name="id" value="10010"/>
        </include>

        <!-- Überschrift -->
        <control type="label">
            <left>0</left>
            <top>90</top>
            <width>2560</width>
            <height>80</height>
            <label>$LOCALIZE[31063]</label>
            <align>center</align>
            <font>font13_title</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>90000000</shadowcolor>
        </control>

        <!-- WALL/PANEL-VIEW FÜR FAVORITEN -->
        <control type="panel" id="10010">
            <left>100</left>
            <top>190</top>
            <width>2360</width>
            <height>1100</height>
            <onup>SetFocus(6666)</onup>
            <ondown>10010</ondown>
            <onleft>10010</onleft>
            <onright>10010</onright>
            <orientation>vertical</orientation>
            <!-- OnClick: Python-Skript ausführen -->
            <onclick>RunScript(special://skin/scripts/script.play.content.py,"$INFO[ListItem.Label]")</onclick>
            <itemlayout width="260" height="390">
                <control type="image">
                    <left>10</left>
                    <top>10</top>
                    <width>240</width>
                    <height>340</height>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>10</left>
                    <top>350</top>
                    <width>240</width>
                    <height>40</height>
                    <label>$INFO[ListItem.Label]</label>
                    <align>center</align>
                    <shadowcolor>DD000000</shadowcolor>
                </control>
            </itemlayout>
            <focusedlayout width="260" height="390">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>260</width>
                    <height>360</height>
                    <texture colordiffuse="FFFFFFFF">$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>360</top>
                    <width>260</width>
                    <height>30</height>
                    <label>$INFO[ListItem.Label]</label>
                    <align>center</align>
                    <textcolor>FFFFCC00</textcolor>
                    <shadowcolor>DD000000</shadowcolor>
                </control>
            </focusedlayout>
            <content>favourites://</content>
            <sortmethod>label</sortmethod>
        </control>

        <!-- SidePanel -->
        <include content="SidePanel">
            <param name="onright">10010</param>
        </include>

        <!-- CodecInfoOverlay unten -->
        <include content="CodecInfoOverlayBottomRight"/>
    </controls>
</window>